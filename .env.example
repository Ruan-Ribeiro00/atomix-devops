# Copie para .env e troque as senhas:  cp .env.example .env
# O arquivo .env NÃO deve ir para o GitHub.

# Senha dos usuários administrativos do Oracle (SYS / SYSTEM)
ORACLE_PASSWORD=TroqueEssaSenha#2026

# Schema/usuário da aplicação ATOMIX (criado automaticamente no FREEPDB1)
DB_USER=ATOMIX
DB_PASSWORD=TroqueEssaSenha#App

# Porta publicada da API na VM
API_PORT=8080
